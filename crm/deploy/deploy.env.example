# Copy to deploy.env (ignored by git) and fill in. Only the deploy script on your own computer reads it.
# Secrets are NOT stored here: the script generates database passwords on the server, and asks for
# API keys at hidden prompts.

# How to reach the server: an ssh host alias from ~/.ssh/config, logged in as root.
DEPLOY_SSH=my-server

# Folder on the server for this stack.
REMOTE_DIR=/opt/mws-crm

# Web addresses (DNS A records must point at the server first).
CRM_HOST=crm.example.com
CHAT_HOST=chat.example.com
LEADS_HOST=leads.example.com
ACME_EMAIL=you@example.com

# The website that sends leads and hosts the chat bubble.
SITE_ORIGIN=https://example.com
THANKS_URL=https://example.com/thanks/

# The model the chat bot uses: any OpenAI-compatible endpoint the server can reach.
BRAIN_URL=http://model-server.example:8096/v1
BRAIN_MODEL=model-name
# A command that prints the model's API key, run on YOUR computer at deploy time (never stored).
# Example: BRAIN_API_KEY_CMD='ssh model-box "cat ~/secrets/model.key"'
BRAIN_API_KEY_CMD=
