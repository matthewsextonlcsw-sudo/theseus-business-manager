# Copy to deploy.env (ignored by git) and fill in. Only the deploy script on your own computer reads it.
# Secrets are NOT stored here: the script generates database passwords on the server, and asks for
# API keys at hidden prompts.

# How to reach the server: an ssh host alias from ~/.ssh/config, logged in as root.
DEPLOY_SSH=my-server

# Folder on the server for this stack.
REMOTE_DIR=/opt/mws-crm

# Web addresses (DNS A records must point at the server first).
CRM_HOST=crm.example.com
CHAT_HOST=chat.example.com
LEADS_HOST=leads.example.com
ACME_EMAIL=you@example.com
# Setup lock: until your Twenty and Chatwoot accounts exist, only this address can open them (the first
# visitor would otherwise claim the admin). Your home's public address; deploy.sh unlock ends it.
SETUP_ALLOW_IP=

# The website that sends leads and hosts the chat bubble.
SITE_ORIGIN=https://example.com
THANKS_URL=https://example.com/thanks/

# The model the chat bot uses: any OpenAI-compatible endpoint the server can reach.
BRAIN_URL=http://model-server.example:8096/v1
# With the private link below, use BRAIN_URL=http://10.77.0.1:<model port>/v1
BRAIN_MODEL=model-name
# A command that prints the model's API key, run on YOUR computer at deploy time (never stored).
# Example: BRAIN_API_KEY_CMD='ssh model-box "cat ~/secrets/model.key"'
BRAIN_API_KEY_CMD=

# Email (optional; deploy.sh mail). Leave MAIL_HOST empty to skip.
# Before deploy.sh mail: a DNS A record for MAIL_HOST pointing at the server.
MAIL_HOST=
MAIL_DOMAIN=
# The mailbox's name before the @, and other names it also receives mail for (space-separated).
# Keep postmaster: mail standards expect every domain to have one.
MAILBOX=
MAIL_ALIASES="postmaster"

# Private link (optional; deploy.sh link): for a model server at home behind NAT. A WireGuard link that carries
# only the model's port, so the CRM server can reach nothing else at home. The model host calls out; no router change.
MODEL_SSH=
# Where the model listens on its own host, ip:port.
MODEL_TARGET=
LINK_PORT=51820
# yes = take the CRM server off Tailscale when the link is up.
LINK_LEAVE_TAILSCALE=no
