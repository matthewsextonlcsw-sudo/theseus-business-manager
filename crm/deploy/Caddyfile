# HTTPS for the three web addresses. Caddy gets and renews certificates on its own.
{
	email {$ACME_EMAIL}
}

# Setup lock: while SETUP_ALLOW_IP is set (caddy.env), the CRM and chat apps answer only that address,
# so nobody else can claim their first-run admin before you do. Unset it once your accounts exist.
(setup_lock) {
	@not_owner not remote_ip {$SETUP_ALLOW_IP:0.0.0.0/0 ::/0}
	respond @not_owner "Setting up. Back soon." 403
}

(security) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# CRM_UPSTREAM: an existing Twenty reached over the private link, else the stack's own.
{$CRM_HOST} {
	import security
	import setup_lock
	encode zstd gzip
	reverse_proxy {$CRM_UPSTREAM:twenty-server:3000}
}

{$CHAT_HOST} {
	import security
	import setup_lock
	encode zstd gzip
	reverse_proxy chatwoot-rails:3000
}

{$LEADS_HOST} {
	import security
	request_body {
		max_size 64KB
	}
	@open path /lead /chatwoot/webhook /health
	handle @open {
		reverse_proxy connector:8080
	}
	handle {
		respond 404
	}
}

# Extra sites written by deploy.sh: the mail server's web pages when email is on (caddy-sites/mail.caddy).
import /etc/caddy/sites/*.caddy
