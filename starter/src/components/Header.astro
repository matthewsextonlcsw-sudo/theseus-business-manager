---
import { site } from '../data/site';

const links = [
  { href: '/', label: 'Home' },
  { href: '/contact/', label: 'Contact' }
];
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/">{site.name}</a>
    <nav aria-label="Primary">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <a class="button" href={site.primaryAction.href}>{site.primaryAction.label}</a>
  </div>
</header>

<style>
  .site-header { border-bottom: 1px solid var(--color-border); }
  .bar { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); padding-block: var(--space-3); }
  .brand { font-weight: 700; font-size: var(--font-size-1); color: var(--color-text); text-decoration: none; margin-right: auto; }
  nav ul { display: flex; gap: var(--space-3); list-style: none; margin: 0; padding: 0; }
  nav a { display: inline-flex; min-height: var(--tap); align-items: center; }
</style>
