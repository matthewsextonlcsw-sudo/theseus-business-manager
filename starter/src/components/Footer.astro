---
import { site } from '../data/site';

const telHref = `tel:${site.phone.replace(/[^\d+]/g, '')}`;
const year = new Date().getFullYear();
---
<footer class="site-footer section--alt">
  <div class="wrap grid">
    <div>
      <p><strong>{site.name}</strong></p>
      <address>
        {site.address.street}<br />
        {site.address.city}, {site.address.region} {site.address.postalCode}
      </address>
    </div>
    <div>
      <p><a href={telHref}>{site.phone}</a></p>
      <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>
    <div>
      <p><strong>Hours</strong></p>
      <ul class="hours">
        {site.hours.map((h) => <li>{h.days.join(', ')}: {h.opens} to {h.closes}</li>)}
      </ul>
    </div>
  </div>
  <div class="wrap legal">
    <p class="muted">© {year} {site.name} · <a href="/privacy/">Privacy</a></p>
  </div>
</footer>

<style>
  .site-footer { padding-block: var(--space-5); margin-top: var(--space-6); }
  address { font-style: normal; }
  .hours { list-style: none; margin: 0; padding: 0; }
  .legal { margin-top: var(--space-4); }
</style>
