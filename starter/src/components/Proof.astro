---
import { proof, site } from '../data/site';

// Only real, permitted proof. Never shown for regulated clinical practices.
const show = proof.length > 0 && !site.regulated;
---
{show && (
  <section class="section" aria-labelledby="proof-heading">
    <div class="wrap">
      <h2 id="proof-heading">What clients say</h2>
      <div class="grid">
        {proof.map((p) => (
          <figure class="card">
            <blockquote><p>{p.quote}</p></blockquote>
            <figcaption class="muted">{p.who}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  figure { margin: 0; }
  blockquote { margin: 0 0 var(--space-2); }
</style>
